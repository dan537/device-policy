# Copy this file to .env and fill in the API key.
# .env is gitignored. Never commit it, never paste its contents into a chat.
#
# Get the API key from the bottom of https://my.nextdns.io/account (API section).
# It grants full read/write over every profile on the account, so treat it as a
# credential. It can be rotated from that same page.

NEXTDNS_API_KEY=

# Profile IDs (not secrets — these appear in DNS hostnames).
# phone = strict:   blocks porn, Reddit, Discord, Telegram, VPN/bypass tooling
# pc    = moderate: blocks porn and bypass tooling, allows Discord/Telegram
NEXTDNS_PROFILE_PHONE=f5b1aa
NEXTDNS_PROFILE_PC=d784cb
