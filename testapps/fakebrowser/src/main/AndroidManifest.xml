<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="Fake Browser">
        <!--
            Shaped exactly like a real browser: handles http and https with NO
            host and NO path, so it will take any URL. PolicyEngine must detect
            and suspend this even though the package name is unknown to it.

            android.app.Activity is used directly so this test APK needs no
            source code of its own.
        -->
        <activity
            android:name="android.app.Activity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>
    </application>
</manifest>
